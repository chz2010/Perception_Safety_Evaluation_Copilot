PROJECT1_MCP_ENABLED=true
PROJECT1_MCP_PROJECT_DIR=../Autonomous_Driving_Safety_Analyst
PROJECT1_MCP_SERVER=mcp_server.py
PROJECT1_MCP_TIMEOUT=90
PROJECT1_MCP_EMBEDDING_BACKEND=local
PROJECT1_RESULTS_PER_SOURCE=3
# Keep false for a fully local/no-OpenAI default. The existing Project 1 video
# collection uses OpenAI embeddings; enable only when Project 1 has an API key.
PROJECT1_MCP_VIDEO_ENABLED=false

LOCAL_EMBEDDINGS_ENABLED=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LOCAL_EMBEDDING_DEVICE=cpu
EVALUATION_CHROMA_PATH=./vectordb/evaluation_evidence
EVALUATION_COLLECTION_PREFIX=perception_evaluations
HISTORICAL_RESULTS_K=3

LEXICAL_FALLBACK_ENABLED=true
